---
import { ARTICLE10_URL, CODE, PRIOR_ART_URL, SPEC_URL, WHY_URL, type Content, type Locale } from '../i18n/content'

interface Props {
  locale: Locale
  c: Content
}
const { locale, c } = Astro.props
const isZh = locale === 'zh-TW'
---

<!-- 1. Hero -->
<section class="hero">
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="container hero__inner reveal">
    <p class="badge"><span class="badge__dot" aria-hidden="true"></span>urn:influence-disclosure:v0</p>
    <h1>
      {c.hero.line1}<br />{c.hero.line2}
    </h1>
    <p class="hero__sub">{c.hero.sub}</p>
    <div class="hero__actions">
      <a class="btn btn--primary" href="#verify">{c.hero.primary}</a>
      <a class="btn btn--secondary" href={SPEC_URL} rel="noopener">{c.hero.secondary}</a>
    </div>
    <p class="small hero__note">{c.hero.note}</p>
  </div>
</section>

<!-- 2. What it records -->
<section class="section section--flush" id="records">
  <div class="container">
    <div class="reveal">
      <p class="eyebrow">{c.records.eyebrow}</p>
      <h2>{c.records.title}</h2>
    </div>
    <div class="grid3">
      {
        c.records.cards.map((card) => (
          <article class="card reveal">
            <h3>{card.term}</h3>
            <p>{card.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<!-- 3. Verify -->
<section class="section" id="verify">
  <div class="container">
    <div class="reveal">
      <p class="eyebrow">{c.verify.eyebrow}</p>
      <h2>{c.verify.title}</h2>
      <p class="lede v__lede">{c.verify.lede}</p>
    </div>

    <div class="v reveal">
      <div class="v__bar">
        <label class="small" for="v-input">{c.verify.label}</label>
        <div class="v__samples">
          <button class="btn btn--ghost" type="button" data-sample="clean">{c.verify.samples.clean}</button>
          <button class="btn btn--ghost" type="button" data-sample="partial">{c.verify.samples.partial}</button>
          <button class="btn btn--ghost" type="button" data-sample="broken">{c.verify.samples.broken}</button>
        </div>
      </div>
      <textarea id="v-input" spellcheck="false" autocomplete="off" rows="14">{CODE.prefill}</textarea>
      <div class="v__run">
        <button class="btn btn--primary" type="button" id="v-run">{c.verify.run}</button>
        <p class="small v__offline">{c.verify.offline}</p>
      </div>
      <output class="v__out" id="v-out" aria-live="polite"></output>
    </div>
  </div>

  <script
    is:inline
    define:vars={{
      samples: { clean: CODE.clean, partial: CODE.partial, broken: CODE.broken },
      t: c.verify.result,
    }}
  >
    window.__ID_SAMPLES = samples
    window.__ID_T = t
  </script>

  <script>
    // The only island. The library is pulled in on first use so the page ships almost no
    // JavaScript until somebody actually asks for a verification.
    const $ = (s: string) => document.querySelector(s)
    const input = $('#v-input') as HTMLTextAreaElement | null
    const out = $('#v-out') as HTMLElement | null
    const run = $('#v-run') as HTMLButtonElement | null
    if (input && out && run) {
      const t = (window as any).__ID_T
      const samples = (window as any).__ID_SAMPLES

      document.querySelectorAll<HTMLButtonElement>('[data-sample]').forEach((b) =>
        b.addEventListener('click', () => {
          input.value = samples[b.dataset.sample as string]
          out.innerHTML = ''
          input.focus()
        }),
      )

      const esc = (s: string) => s.replace(/[<>&]/g, (ch) => ({ '<': '&lt;', '>': '&gt;', '&': '&amp;' })[ch]!)

      const render = (ok: boolean, head: string, lines: string[]) => {
        out.innerHTML =
          `<p class="v__verdict ${ok ? 'is-ok' : 'is-bad'}">${esc(head)}</p>` +
          `<ul class="v__list">${lines.map((l) => `<li>${l}</li>`).join('')}</ul>`
      }

      run.addEventListener('click', async () => {
        run.disabled = true
        try {
          let doc: unknown
          try {
            doc = JSON.parse(input.value)
          } catch {
            render(false, t.invalid, [esc(t.parseError)])
            return
          }

          const lib = await import('influence-disclosure')
          const hosts: [string, (d: unknown) => any][] = [
            ['verifiable credential', lib.fromCredentialSubject],
            ['DSSE envelope', lib.fromDsse],
            ['A2A metadata', lib.fromA2AMetadata],
            ['MCP audit record', lib.fromMcpExtension],
          ]

          let source = 'bare section'
          let result: any = lib.validateInfluence(doc)
          let section: any = result.valid ? doc : null

          if (!result.valid) {
            for (const [name, read] of hosts) {
              const found = read(doc)
              if (found.present) {
                source = name
                if (found.valid) {
                  section = found.section
                  result = lib.validateInfluence(section)
                } else {
                  result = { valid: false, errors: found.errors, warnings: [] }
                }
                break
              }
            }
          }

          const where = t.hosts[source] ?? source

          if (!result.valid || !section) {
            render(false, t.invalid, [
              ...result.errors.map(
                (e: any) => `<code>${esc(e.path === '' ? '/' : e.path)}</code> ${esc(e.message)}`,
              ),
            ])
            return
          }

          const affected = section.relationships.filter((r: any) => r.effect.kind !== 'none').length
          const lines = [
            `${esc(t.foundIn)} <strong>${esc(where)}</strong>`,
            section.relationships.length === 0
              ? esc(t.none)
              : `<strong>${section.relationships.length}</strong> ${esc(t.relationships)}, <strong>${affected}</strong> ${esc(t.affected)}`,
            `${esc(t.completeness)}: <code>${esc(section.completeness)}</code>`,
          ]
          if (section.withheld_reason) {
            lines.push(`${esc(t.withheld)}: <code>${esc(section.withheld_reason)}</code>`)
          }
          for (const w of result.warnings) {
            lines.push(`<span class="v__warn">warning</span> <code>${esc(w.path || '/')}</code> ${esc(w.message)}`)
          }
          render(true, t.valid, lines)
        } finally {
          run.disabled = false
        }
      })
    }
  </script>
</section>

<!-- 4. Article 10 -->
<section class="section" id="article10">
  <div class="container">
    <div class="reveal">
      <p class="eyebrow">{c.article10.eyebrow}</p>
      <h2>{c.article10.title}</h2>
      <p class="lede">{c.article10.lede}</p>
    </div>

    <div class="a10 reveal">
      <figure class="quote">
        <figcaption class="small">{c.article10.quoteLabel}</figcaption>
        <blockquote>{c.article10.quote}</blockquote>
        <p class="small quote__src">{c.article10.source}</p>
      </figure>

      <aside class="warn">
        <p class="warn__title">{c.article10.warningTitle}</p>
        <p class="small">{c.article10.warningBody}</p>
      </aside>
    </div>

    <div class="tablewrap reveal">
      <table class="t10">
        <thead>
          <tr>{c.article10.tableHead.map((h) => <th scope="col">{h}</th>)}</tr>
        </thead>
        <tbody>
          {
            c.article10.rows.map(([wording, maps, carrier]) => (
              <tr>
                <td class="t10__quote">{wording}</td>
                <td set:html={maps.replace(/`([^`]+)`/g, '<code>$1</code>')} />
                <td>
                  <span class={`chip ${carrier === 'section' ? 'chip--ours' : ''}`}>
                    {carrier === 'section' ? c.article10.carrier.section : c.article10.carrier.host}
                  </span>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="a10__actions reveal">
      <a class="btn btn--primary" href="/article-10-mapping.pdf" download>{c.article10.download}</a>
      <a class="btn btn--secondary" href={ARTICLE10_URL} rel="noopener">{c.article10.full}</a>
    </div>
  </div>
</section>

<!-- 5. Install -->
<section class="section" id="install">
  <div class="container">
    <div class="reveal">
      <p class="eyebrow">{c.install.eyebrow}</p>
      <h2>{c.install.title}</h2>
      <p class="lede">{c.install.lede}</p>
    </div>

    <pre class="npx reveal"><code>{c.install.npx}</code></pre>

    <div class="tabs reveal">
      {
        c.install.tabs.map((tab, i) => (
          <>
            <input
              type="radio"
              name={`host-${locale}`}
              id={`tab-${locale}-${tab.id}`}
              checked={i === 0}
              class="tabs__radio"
            />
            <label class="tabs__label" for={`tab-${locale}-${tab.id}`}>
              {tab.label}
            </label>
            <div class="tabs__panel">
              <p class="small tabs__note">{tab.note}</p>
              <pre><code>{tab.code}</code></pre>
            </div>
          </>
        ))
      }
    </div>
  </div>
</section>

<!-- 6. Why labels fail -->
<section class="section" id="why">
  <div class="container">
    <div class="reveal">
      <p class="eyebrow">{c.why.eyebrow}</p>
      <h2>{c.why.title}</h2>
      <p class="lede">{c.why.lede}</p>
    </div>

    <ol class="cites">
      {
        c.why.items.map((it) => (
          <li class="cite reveal">
            <a class="cite__src" href={it.href} rel="noopener">
              {it.source}
            </a>
            <p class="small cite__venue">{it.venue}</p>
            <p>{it.claim}</p>
          </li>
        ))
      }
    </ol>

    <div class="a10__actions reveal">
      <a class="btn btn--secondary" href={WHY_URL} rel="noopener">{c.why.more}</a>
      <a class="btn btn--secondary" href={PRIOR_ART_URL} rel="noopener">
        {isZh ? '既有技術盤點' : 'Prior art'}
      </a>
    </div>
  </div>
</section>

<style>
  /* ---- hero ---- */
  .hero {
    position: relative;
    padding-block: var(--hero-y) var(--section-y);
    overflow: hidden;
  }
  /* the reference paints its glow with a WebGL particle dome; this is the same
     light distribution as one static radial layer. See site/DESIGN.md. */
  /* The reference paints its glow with a WebGL particle dome; this is the same light
     distribution as one static radial layer. Sized as an ellipse that fits inside the
     hero: a circle wide enough to match the reference overflows and gets clipped by
     .hero's overflow:hidden, leaving only its faint outer edge visible. */
  .hero__glow {
    position: absolute;
    left: 50%;
    top: 56%;
    width: min(1400px, 140vw);
    height: 760px;
    transform: translate(-50%, -50%);
    background: radial-gradient(
      ellipse 50% 50% at 50% 50%,
      rgba(96, 186, 255, 0.42) 0%,
      rgba(0, 131, 255, 0.3) 18%,
      rgba(0, 131, 255, 0.14) 36%,
      rgba(0, 106, 214, 0.05) 54%,
      transparent 72%
    );
    filter: blur(28px);
    pointer-events: none;
    z-index: 0;
  }
  /* the reference sets its hero eyebrow as a pill badge with a leading dot */
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 24px;
    padding: 8px 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.04);
    font-size: 14px;
    font-weight: 400;
    letter-spacing: -0.04em;
    color: var(--fg-3);
    font-family: var(--font-mono);
  }
  .badge__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    flex: none;
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  /* ch is derived from the Latin "0" advance, so it is the wrong ruler for CJK lines.
     A px cap keeps both hero lines unbroken at the measured display size. */
  .hero h1 {
    max-width: 1220px;
  }
  /* A CJK glyph fills its em box, so 64px Traditional Chinese carries far more visual
     weight than 64px Latin and overruns the measured two-line hero. Stepped down so the
     zh hero lands on two lines at the same optical size. See site/DESIGN.md. */
  :global(html[lang^='zh']) .hero h1 {
    font-size: 52px;
  }
  .hero__sub {
    margin-top: 24px;
    max-width: 62ch;
    color: var(--fg-2);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 32px;
  }
  .hero__note {
    margin-top: 24px;
  }

  /* ---- cards ---- */
  .grid3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 48px;
  }
  .grid3 h3 {
    margin-bottom: 12px;
  }
  .grid3 p {
    font-size: 17px;
    line-height: 1.7;
  }

  /* ---- verifier ---- */
  .v__lede {
    margin-bottom: 0;
  }
  .v {
    margin-top: 40px;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--card);
    padding: 24px;
  }
  .v__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
  }
  .v__samples {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .v textarea {
    width: 100%;
    resize: vertical;
    background: #000;
    color: var(--fg-2);
    border: 1px solid var(--line);
    border-radius: var(--radius-code);
    padding: 16px;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.65;
    tab-size: 2;
  }
  .v textarea:focus {
    border-color: var(--accent);
    outline: none;
  }
  .v__run {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    margin-top: 16px;
  }
  .v__offline {
    margin: 0;
  }
  .v__out:empty {
    display: none;
  }
  .v__out {
    display: block;
    margin-top: 20px;
    border-top: 1px solid var(--line);
    padding-top: 20px;
  }
  .v__out :global(.v__verdict) {
    font-size: 20px;
    font-weight: 500;
    letter-spacing: -0.02em;
    margin: 0 0 12px;
  }
  .v__out :global(.is-ok) {
    color: var(--accent);
  }
  .v__out :global(.is-bad) {
    color: #ff8f8f;
  }
  .v__out :global(.v__list) {
    margin: 0;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .v__out :global(li) {
    font-size: 15px;
    line-height: 1.6;
    color: var(--fg-2);
  }
  .v__out :global(code) {
    background: rgba(255, 255, 255, 0.07);
    padding: 2px 6px;
    border-radius: 4px;
  }
  .v__out :global(.v__warn) {
    color: #ffd08a;
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* ---- article 10 ---- */
  .a10 {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 20px;
    margin-top: 48px;
  }
  .quote {
    margin: 0;
    padding: 32px;
    border: 1px solid var(--line);
    border-left: 2px solid var(--accent);
    border-radius: var(--radius-card);
    background: var(--card);
  }
  .quote blockquote {
    margin: 12px 0 16px;
    font-size: 19px;
    line-height: 1.8;
    color: var(--fg);
  }
  .quote__src {
    margin: 0;
  }
  .warn {
    padding: 32px;
    border: 1px solid rgba(255, 208, 138, 0.28);
    border-radius: var(--radius-card);
    background: rgba(255, 208, 138, 0.06);
  }
  .warn__title {
    margin: 0 0 8px;
    font-size: 16px;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: #ffd08a;
  }
  .warn .small {
    color: var(--fg-2);
  }
  .tablewrap {
    margin-top: 20px;
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
  }
  .t10 {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
    min-width: 620px;
  }
  .t10 th,
  .t10 td {
    text-align: left;
    padding: 16px 20px;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  .t10 th {
    font-weight: 500;
    font-size: 13px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--fg-4);
  }
  .t10 tbody tr:last-child td {
    border-bottom: 0;
  }
  .t10__quote {
    color: var(--fg);
  }
  .t10 td {
    color: var(--fg-2);
  }
  .t10 :global(code) {
    background: rgba(255, 255, 255, 0.07);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 13px;
  }
  .chip {
    display: inline-block;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line);
    font-size: 12px;
    color: var(--fg-4);
    white-space: nowrap;
  }
  .chip--ours {
    border-color: rgba(0, 131, 255, 0.5);
    background: var(--accent-dim);
    color: #9ccdff;
  }
  .a10__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  /* ---- install ---- */
  .npx {
    margin: 40px 0 24px;
    padding: 20px 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius-code);
    background: var(--card);
    overflow-x: auto;
    color: var(--fg);
  }
  /* A trailing 1fr column absorbs the leftover width so that a panel spanning 1/-1 is
     full width; with only max-content columns it would stop at the last label. */
  .tabs {
    display: grid;
    grid-template-columns: repeat(4, max-content) 1fr;
    gap: 8px;
  }
  .tabs__radio {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .tabs__label {
    grid-row: 1;
    padding: 10px 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    font-size: 14px;
    letter-spacing: -0.02em;
    color: var(--fg-3);
    cursor: pointer;
    transition: all 160ms var(--ease);
  }
  .tabs__label:hover {
    color: var(--fg);
    border-color: var(--line-strong);
  }
  .tabs__radio:checked + .tabs__label {
    background: var(--fg);
    color: #000;
    border-color: var(--fg);
  }
  .tabs__radio:focus-visible + .tabs__label {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .tabs__panel {
    grid-row: 2;
    grid-column: 1 / -1;
    display: none;
    margin-top: 16px;
  }
  .tabs__radio:checked + .tabs__label + .tabs__panel {
    display: block;
  }
  .tabs__note {
    margin: 0 0 10px;
  }
  .tabs pre {
    margin: 0;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius-code);
    background: var(--card);
    overflow-x: auto;
    line-height: 1.7;
    color: var(--fg-2);
  }

  /* ---- citations ---- */
  .cites {
    list-style: none;
    margin: 48px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .cite {
    padding: 32px;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
  }
  .cite__src {
    font-size: 20px;
    font-weight: 500;
    letter-spacing: -0.03em;
    text-decoration: none;
    color: var(--fg);
    border-bottom: 1px solid transparent;
    transition: border-color 160ms var(--ease);
  }
  .cite__src:hover {
    border-bottom-color: var(--accent);
  }
  .cite__venue {
    margin: 6px 0 14px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0;
    color: var(--accent);
  }
  .cite p:not(.cite__venue) {
    font-size: 16px;
    line-height: 1.7;
    margin: 0;
  }

  @media (max-width: 992px) {
    :global(html[lang^='zh']) .hero h1 {
      font-size: 40px;
    }
    .grid3,
    .cites,
    .a10 {
      grid-template-columns: 1fr;
    }
    .tabs {
      grid-template-columns: repeat(2, 1fr);
    }
    .tabs__panel {
      grid-column: 1 / -1;
    }
    .tabs__label {
      grid-row: auto;
      text-align: center;
    }
    .tabs__panel {
      grid-row: 3;
    }
  }
  @media (max-width: 480px) {
    :global(html[lang^='zh']) .hero h1 {
      font-size: 28px;
    }
    .v {
      padding: 16px;
    }
    .quote,
    .warn,
    .cite {
      padding: 24px;
    }
    .hero__actions .btn {
      padding-inline: 18px;
    }
  }
</style>
